+def _posicao(code, index):
+    """Retorna linha e coluna (1-based) para um índice da string."""
+    line = code.count("\n", 0, index) + 1
+    last_newline = code.rfind("\n", 0, index)
+    column = index - last_newline if last_newline != -1 else index + 1
+    return line, column
+
